# Desarrollo local: PostgreSQL embebido y persistente mediante PGlite.
# Si se omite, se guarda fuera de OneDrive en ~/.icaza-live/pglite.
# PGLITE_DATA_DIR=/ruta/local/icaza-live/pglite
LOCAL_ADMIN_PASSWORD=replace-this-local-password

# Producción/Replit: al definir DATABASE_URL se utiliza PostgreSQL administrado.
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/icaza_live

# Zoom OAuth
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/api/integrations/zoom/callback
ZOOM_WEBHOOK_SECRET=

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_IVS_CHANNEL_ARN=

# SSO corporativo (OIDC o SAML)
APP_BASE_URL=http://localhost:3000
SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
SSO_CLIENT_SECRET=
SSO_SAML_CERTIFICATE=
AUTH_ENCRYPTION_KEY=

# MFA
MFA_ISSUER=Icaza Live
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
EMAIL_FROM=

# Correo saliente — Amazon SES
# Se usa SES automáticamente cuando estas variables están definidas.
# El usuario IAM solo necesita ses:SendEmail y ses:GetAccount.
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_CONFIGURATION_SET=
EMAIL_REPLY_TO=

# Alternativa a SES (si se prefiere Resend)
# RESEND_API_KEY=

# Centro de ayuda
SUPPORT_EMAIL=soporte@icazalive.local
SALES_EMAIL=ventas@icazalive.local
SUPPORT_HOURS=Lunes a viernes · 08:00–18:00 (America/Bogota)
PRIVACY_EMAIL=privacidad@icazalive.local

# Amazon IVS — grabación automática de los canales aprovisionados (opcional)
AWS_IVS_RECORDING_CONFIGURATION_ARN=
